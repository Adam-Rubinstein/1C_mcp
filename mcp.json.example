{
  "mcpServers": {
    "1c-platform": {
      "command": "C:/Tools/1C_mcp/.venv/Scripts/python.exe",
      "args": ["C:/Tools/1C_mcp/scripts/run_server.py", "platform"],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ONEC_PLATFORM_PATH": "C:/Program Files/1cv8/8.3.27.1719"
      }
    },
    "1c-dump": {
      "command": "C:/Tools/1C_mcp/.venv/Scripts/python.exe",
      "args": ["C:/Tools/1C_mcp/scripts/run_server.py", "dump"],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "ONEC_BIN": "C:/Program Files/1cv8/8.3.27.1719/bin/1cv8.exe",
        "ONEC_IB_DEV": "C:/path/to/InfoBase_DEV",
        "ONEC_IB_WORK": "C:/path/to/InfoBase_WORK",
        "ONEC_IB": "C:/path/to/InfoBase_DEV",
        "ONEC_USER_DEV": "Administrator",
        "ONEC_PASSWORD_DEV": "",
        "ONEC_USER_WORK": "Administrator",
        "ONEC_PASSWORD_WORK": "",
        "ONEC_EXTENSION": "MyExtension",
        "REPO_CF": "C:/path/to/repo/src/cf",
        "REPO_CFE": "C:/path/to/repo/src/cfe",
        "DUMP_TMP_ROOT": "C:/Tools/1C_mcp/.tmp/dump",
        "ONEC_STORAGE_PATH": "\\\\server\\StorageMain\\",
        "ONEC_STORAGE_USER": "StorageUser",
        "ONEC_STORAGE_PASSWORD": "",
        "ONEC_STORAGE_PATH_CFE": "\\\\server\\StorageExt\\"
      }
    },
    "1c-load": {
