# Copy to .env (never commit real values)

MCP_TRANSPORT=stdio

ONEC_PLATFORM_PATH=C:/Program Files/1cv8/8.3.27.1719
ONEC_BIN=C:/Program Files/1cv8/8.3.27.1719/bin/1cv8.exe

# DEV (sandbox) and WORK (your daily IB with storage)
ONEC_IB_DEV=C:/Users/you/Documents/InfoBase2
ONEC_IB_WORK=C:/Users/you/Documents/InfoBase3
ONEC_IB=C:/Users/you/Documents/InfoBase2

ONEC_USER=Administrator
ONEC_PASSWORD=
# Per-IB overrides (recommended when DEV and WORK use different users)
# ONEC_USER_DEV=Administrator
# ONEC_PASSWORD_DEV=
# ONEC_USER_WORK=YourWorkUser
# ONEC_PASSWORD_WORK=
ONEC_EXTENSION=MyExtension

# Optional: explicit /ConfigurationRepository* on Designer reopen.
# Not required for WORK if IB is bound to storage and reopen uses /IBName (starter-like).
# ONEC_STORAGE_PATH=\\server\share\config-repo
# ONEC_STORAGE_USER=your-storage-user
# ONEC_STORAGE_PASSWORD=

REPO_CF=C:/path/to/repo/src/cf
REPO_CFE=C:/path/to/repo/src/cfe
CONFIG_DUMP_DIR=C:/path/to/repo/src/cf
DUMP_TMP_ROOT=C:/Tools/1C_mcp/.tmp/dump
