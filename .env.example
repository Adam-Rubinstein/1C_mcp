# Copy to .env (never commit real values)

MCP_TRANSPORT=stdio

ONEC_PLATFORM_PATH=<1CV8_ROOT>
ONEC_BIN=<1CV8_ROOT>/bin/1cv8.exe

# DEV (sandbox) and WORK (your daily IB with storage)
ONEC_IB_DEV=C:/Users/you/Documents/InfoBase_DEV
ONEC_IB_WORK=C:/Users/you/Documents/InfoBase_WORK
ONEC_IB=C:/Users/you/Documents/InfoBase_DEV

ONEC_USER=Administrator
ONEC_PASSWORD=
# Per-IB overrides (recommended when DEV and WORK use different users)
# ONEC_USER_DEV=Administrator
# ONEC_PASSWORD_DEV=
# ONEC_USER_WORK=YourWorkUser
# ONEC_PASSWORD_WORK=
ONEC_EXTENSION=MyExtension

# Optional: required for WORK dump/load and 1c-storage tools (get/lock/unlock/commit).
# Without this, WORK batch runs offline and desyncs local CF from the repository.
# ONEC_STORAGE_PATH=\\server\share\config-repo
# ONEC_STORAGE_USER=your-storage-user
# ONEC_STORAGE_PASSWORD=

REPO_CF=C:/path/to/repo/src/cf
REPO_CFE=C:/path/to/repo/src/cfe
CONFIG_DUMP_DIR=C:/path/to/repo/src/cf
DUMP_TMP_ROOT=<TOOLKIT_ROOT>/.tmp/dump
# ONEC_ROOT_MARKERS=
# ONEC_CHANGE_MARKERS=
# UI_TITLE_MUST=
# UI_TITLE_DENY=Конфигуратор
# ONEC_SERVER=
# ONEC_SERVER_REF=
# ONEC_SERVER_ALIAS=
# ONEC_USER_SERVER=
# ONEC_PASSWORD_SERVER=
