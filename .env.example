# Copy to packages/<name>/.env or monorepo .env (never commit real values)

# --- Common ---
MCP_TRANSPORT=stdio
# MCP_TRANSPORT=sse
# MCP_HOST=0.0.0.0
# MCP_PORT=8761
# MCP_TOKEN=generate-with-openssl-rand-or-python

# --- Platform (JAR) ---
ONEC_PLATFORM_PATH=C:/Program Files/1cv8/8.3.27.1719
JAVA_BIN=java

# --- Designer dump/load ---
ONEC_BIN=C:/Program Files/1cv8/8.3.27.1719/bin/1cv8.exe
# File IB:
ONEC_IB=C:/path/to/InfoBase
# Or server IB:
# ONEC_SERVER=localhost
# ONEC_REF=MyBase
ONEC_USER=Администратор
ONEC_PASSWORD=
ONEC_EXTENSION=Эстет_Доработки
REPO_CF=C:/path/to/repo/src/cf
REPO_CFE=C:/path/to/repo/src/cfe
CONFIG_DUMP_DIR=C:/path/to/repo/src/cf
DUMP_TMP_ROOT=C:/path/to/repo/.tmp/1c-dump

# --- COM / journal ---
# same ONEC_* as above

# --- Review ---
# REVIEW_RULES_PATH=C:/path/to/rules.yaml

# --- Debug (dbgs HTTP) ---
# DEBUG_SERVER_URL=http://127.0.0.1:1550
# DEBUG_INFOBASE_ALIAS=MyBase

# --- BSL LS ---
# BSL_LS_JAR=C:/Tools/bsl-language-server/bsl-language-server-*.jar
# BSL_LS_COMMAND=
